{
  "$schema": "https://gitee.com/dotnetchina/Furion/raw/v4/schemas/v4/furion-schema.json",
  "Cache": {
    "Prefix": "dji_", // 全局缓存前缀
    "CacheType": "Memory", // Memory、Redis
    "Redis": {
      "Configuration": "server=localhost:6379;password=<REDIS_PASSWORD>;db=5;", // Redis连接字符串
      "Prefix": "juai_", // Redis前缀
      "MaxMessageSize": "1048576" // 最大消息大小 默认1024 * 1024
    }
  },
  "Cluster": { // 集群配置
    "Enabled": false, // 启用集群：前提开启Redis缓存模式
    "ServerId": "adminnet", // 服务器标识
    "ServerIp": "", // 服务器IP
    "SignalR": {
      "RedisConfiguration": "localhost:6379,ssl=false,password=<REDIS_PASSWORD>,defaultDatabase=5",
      "ChannelPrefix": "juai_"
    },
    "DataProtecteKey": "AdminNet:DataProtection-Keys",
    "IsSentinel": false, // 是否哨兵模式
    "SentinelConfig": {
      "DefaultDb": "4",
      "EndPoints": [ // 哨兵端口
        // "10.10.0.124:26380"
      ],
      "MainPrefix": "adminNet:",
      "Password": "<SENTINEL_PASSWORD>",
      "SentinelPassword": "<SENTINEL_PASSWORD>",
      "ServiceName": "adminNet",
      "SignalRChannelPrefix": "signalR:"
    }
  }
}