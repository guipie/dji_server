{
  "$schema": "https://gitee.com/dotnetchina/Furion/raw/v4/schemas/v4/furion-schema.json",

  "Upload": {
    "Path": "Upload/{yyyy}/{MM}", // 文件上传目录
    "MaxSize": 104857600, //1048576字节等于1024kb 1兆
    "ContentType": [
      "video/mp4",
      "image/jpg",
      "image/png",
      "image/jpeg",
      "image/gif",
      "image/bmp",
      "text/plain",
      "application/pdf",
      "application/msword",
      "application/vnd.ms-excel",
      "application/vnd.ms-powerpoint",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/octet-stream"
    ],
    "EnableMd5": true // 启用文件MDF5验证-防止重复上传
  },
  "OSSProvider": {
    "IsEnable": true,
    "Provider": "Minio", // Invalid/Minio/Aliyun/QCloud/Qiniu/HuaweiCloud
    "Endpoint": "oss.dji.server",
    "Region": "CN_South",
    "AccessKey": "root",
    "SecretKey": "CHENwei716!@.",
    "IsEnableHttps": true,
    "IsEnableCache": true,
    "Bucket": "juai.test"
  }
}